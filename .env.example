# Скопируй в .env и заполни: cp .env.example .env
MODE=LOCAL

# Postgres (в Docker Compose хост — имя сервиса booking_db)
DB_HOST=booking_db
DB_PORT=5432
DB_USER=
DB_PASS=
DB_NAME=

# Redis (в Docker Compose хост — имя сервиса booking_cashe)
REDIS_HOST=booking_cashe
REDIS_PORT=6379

# JWT: сгенерировать ключ можно командой `openssl rand -hex 32`
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
