# Скопируй в .env-test и заполни: cp .env-test.example .env-test
# Используется pytest (см. pytest.ini). MODE обязательно TEST.
MODE=TEST

# Отдельная тестовая база: тесты удаляют и пересоздают все таблицы
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASS=
DB_NAME=test

REDIS_HOST=localhost
REDIS_PORT=6379

JWT_SECRET_KEY=test-secret-key-not-for-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
